  "images": [
    {
      "name": "ucore-minimal",
      "relationship": "LAYER 01",
      "description": "Container host on Fedora CoreOS.",
      "audience": "For a server whose main job is running containers.",
      "hint": "A container host and nothing else. Add what you need on top."
    },
    {
      "name": "ucore",
      "relationship": "LAYER 02",
      "description": "Adds storage and NAS tools: ZFS, Samba, NFS.",
      "audience": "For a server that also looks after disks and shares.",
      "hint": "Adds ZFS, Samba, and NFS for storage and file sharing."
    },
    {
      "name": "ucore-hci",
      "relationship": "LAYER 03",
      "description": "Adds virtualization: KVM and libvirt.",
      "audience": "For a server that also hosts virtual machines.",
      "hint": "Everything in ucore, plus KVM and libvirt for virtual machines."
    }
  ],
