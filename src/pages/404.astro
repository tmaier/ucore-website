---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That uCore website page could not be found." ignoreSearch canonicalPage={false}>
	<section class="page-hero">
		<h1>Page not found</h1>
		<p class="lead">The page may have moved, or the address may be incomplete.</p>
		<p><a href="/">Return to the uCore homepage</a> or browse the <a href="/docs/">documentation</a>.</p>
	</section>
</Base>
