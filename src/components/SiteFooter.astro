---
interface Props {
	docsWidth?: boolean;
}

const { docsWidth = false } = Astro.props;
---

<footer class="site-footer" data-pagefind-ignore>
	<div class:list={['site-footer-inner', { 'docs-width': docsWidth }]}>
		<span>projectucore.org</span>
		<span class="footer-credit">Built on Fedora CoreOS · ublue-os</span>
		<nav class="footer-links" aria-label="Footer links">
			<a href="/announcements/">Announcements</a>
			<a href="/feed.xml">Feed</a>
			<a href="/licenses/ucore-LICENSE.txt">Apache-2.0</a>
		</nav>
	</div>
	<p class="status-message" role="status" id="copy-status" aria-live="polite"></p>
</footer>
